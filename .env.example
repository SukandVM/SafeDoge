EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary — photo uploads (free, unsigned upload preset required)
# Cloud name is in the top-right of your Cloudinary dashboard.
# Upload preset: Settings → Upload → Add upload preset → Signing Mode: UNSIGNED.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
